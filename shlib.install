NAME='shlib'
DESCRIPTION='SHLIB is a Shell Library framework'
HOMEPAGE='https://github.com/major0/shlib'
LICENSE='MIT'
VERSION='0.1.0'

pkg_install() {
	# shlib itself goes to BINDIR; docs to DOCDIR/shlib -- both defaults.
	dobin --template 'shlib'
	dodoc 'README.md' 'LICENSE' doc/*

	# Libraries default to LIBDIR/shlib; install each non-deprecated subtree.
	(cd lib && for d in *; do test "${d}" = 'deprecated' || if test -d "${d}"; then doshlib "${d}"; fi; done)

	# The subcommand helpers live under LIBEXECDIR/shlib.
	exeinto "${LIBEXECDIR}/shlib"
	doexe libexec/*
}
