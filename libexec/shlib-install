#!/usr/bin/env shlib
# Copyright (c) 2014-2025 Mark Ferrell
#
# Licensed under the MIT License, see LICENSE for details.
#
# Shlib Installer
#
# Installs a shlib package.  A package places a data-only `shpkg.vars` manifest
# at its top and follows the strict source layout (bin/, lib/, libexec/,
# docs/).  The manifest is parsed, never sourced, and the layout is fixed by
# the installer -- the package gets no say in it (see docs/shpkg.md).

usage() {
	if test "$#" -gt '0'; then
		error "$*"
		echo "try '${0} --help'" >&2
		exit 1
	fi

	sed -e 's/	//'<<EOF
	usage: ${PROGNAME} [options] [<source>]

	<source> is the package directory to install (default: the current
	directory).

	options:
	  -n, --dry-run		Don't do anything, just print what would be done
	  -x, --trace		Trace script execution
	  -h, --help		Display this help

	 install options:
	  --prefix=DIR		Install in DIR
	  --bindir=DIR		Install binaries in DIR
	  --sbindir=DIR		Install system binaries in DIR
	  --libdir=DIR		Install libraries in DIR
	  --libexecdir=DIR	Install library executables in DIR
	  --docdir=DIR		Install documentation into DIR
	  --mandir=DIR		Install man pages into DIR
	--sysconfdir=DIR	Install config files into DIR
	  --show-config		Show the current install config

EOF
	exit 0 # Requests for help are never an error
}

main {
	: "main: $*"
	DRYRUN='false'
	SHOWCONFIG='false'
	while getopts ':hnx' __opt_arg; do
		# Traditional POSIX short-option handling
		case "${__opt_arg}" in
		(h)	usage;;
		(n)	DRYRUN='true';;
		(x)	set -x;;

		# We evoked `getopts` with a `:` prefix optstring which allows us
		# to inspect any and all non-opts w/out terminating option
		# parsing. I.e. we can look for long-opts via POSIX `getopts`.
		# One would argue that we can simply use `getopt(1)`, but that
		# CLI utility is not entirely portable between all flavours of
		# Unix.
		(\?)	: "extended options: index=${OPTIND}, arg='${__opt_arg}', optarg='${OPTARG}'"
			shift "$(__shlib_shiftarg)"
			OPTIND=1
			: "extended arg: '${1}'"

			case "${1}" in
			(--dry-run)
				DRYRUN='true';;
			(--show-config|--showconfig)
				SHOWCONFIG='true';;
			(--trace|--debug)
				set -x;;
			(help|--help)
				usage;;

			(--prefix|--prefix=*)
				OPTARG="$(optarg "${1}" "${2}")"
				test -n "${OPTARG}" || usage "option '${1}' requires an argument"
				PREFIX="${OPTARG}";;

			(--bindir|--bindir=*)
				OPTARG="$(optarg "${1}" "${2}")"
				test -n "${OPTARG}" || usage "option '${1}' requires an argument"
				BINDIR="${OPTARG}";;

			(--sbindir|--sbindir=*)
				OPTARG="$(optarg "${1}" "${2}")"
				test -n "${OPTARG}" || usage "option '${1}' requires an argument"
				SBINDIR="${OPTARG}";;

			(--libdir|--libdir=*)
				OPTARG="$(optarg "${1}" "${2}")"
				test -n "${OPTARG}" || usage "option '${1}' requires an argument"
				LIBDIR="${OPTARG}";;

			(--libexecdir|--libexecdir=*)
				OPTARG="$(optarg "${1}" "${2}")"
				test -n "${OPTARG}" || usage "option '${1}' requires an argument"
				LIBEXECDIR="${OPTARG}";;

			(--docdir|--docdir=*)
				OPTARG="$(optarg "${1}" "${2}")"
				test -n "${OPTARG}" || usage "option '${1}' requires an argument"
				DOCDIR="${OPTARG}";;

			(--mandir|--mandir=*)
				OPTARG="$(optarg "${1}" "${2}")"
				test -n "${OPTARG}" || usage "option '${1}' requires an argument"
				MANDIR="${OPTARG}";;

			(--sysconfdir|--sysconfdir=*)
				OPTARG="$(optarg "${1}" "${2}")"
				test -n "${OPTARG}" || usage "option '${1}' requires an argument"
				SYSCONFDIR="${OPTARG}";;

			# Posixly Correct
			(--)	OPTIND="$((OPTIND + 1))"; break;;
			(-*)	usage "unknown option '${1}'";;
			(*)	break;;
			esac

			shift "${OPTIND}"
			OPTIND=1;;
		esac
	done
	unset __opt_arg
	shift $((OPTIND - 1))
	OPTIND=1
	unset OPTARG

	if test "$(id -u)" -eq '0'; then
		PREFIX="${PREFIX:-/usr/local}"
	else
		PREFIX="${PREFIX:-${HOME}/.local}"
	fi

	## Normalize the prefix
	# POSIX requires that all paths that are prefixed with `//` be allowed
	# to be interpretted differently than paths prefixed with `/`. The
	# specification further states that paths prefixed with 3-or-more `/`
	# characters be treated as if only 1 `/` was provided.
	#
	# This means that we _must_ cleanly pass paths which are prefixed with
	# 2 slashes, `//`, to the operation system w/out manipulation, since
	# these paths may not end up in the traditional root, `/`, fileystem.
	#
	# In order to avoid manually parsing the entire path, we expect that all
	# components "up to" the last path entry must exist. This is also a
	# requirement of `realpath` resolution. This means that if a user wants
	# to install something in `${HOME}/.local/<app>-<version>`, then the
	# leading portion of the path; `"${HOME}/.local"`; must already exist.
	#
	# This seems a reasonable requirement.
	PREFIX="$(__shlib_realpath "${PREFIX}")"

	case "${PREFIX}" in
	(/|//)	SYSCONFDIR="${SYSCONFDIR:-${PREFIX}etc}"
		BINDIR="${BINDIR:-${PREFIX}bin}"
		SBINDIR="${SBINDIR:-${PREFIX}sbin}"
		LIBDIR="${LIBDIR:-${PREFIX}lib}"
		LIBEXECDIR="${LIBEXECDIR:-${PREFIX}libexec}"
		DOCDIR="${DOCDIR:-${PREFIX}share/doc}"
		MANDIR="${MANDIR:-${PREFIX}share/man}"
		;;
	(*)
		SYSCONFDIR="${SYSCONFDIR:-${PREFIX}/etc}"
		BINDIR="${BINDIR:-${PREFIX}/bin}"
		SBINDIR="${SBINDIR:-${PREFIX}/sbin}"
		LIBDIR="${LIBDIR:-${PREFIX}/lib}"
		LIBEXECDIR="${LIBEXECDIR:-${PREFIX}/libexec}"
		DOCDIR="${DOCDIR:-${PREFIX}/share/doc}"
		MANDIR="${MANDIR:-${PREFIX}/share/man}"
		;;
	esac

	## Strip trailing slashes.
	# WARNING: this will break should anyone have set any of these paths
	# to `//`; for whatever reason.
	SYSCONFDIR="${SYSCONFDIR%%/}"
	BINDIR="${BINDIR%%/}"
	SBINDIR="${SBINDIR%%/}"
	LIBDIR="${LIBDIR%%/}"
	LIBEXECDIR="${LIBEXECDIR%%/}"
	DOCDIR="${DOCDIR%%/}"
	MANDIR="${MANDIR%%/}"

	if "${SHOWCONFIG}"; then
		printf "%15s '%s'\n" 'prefix:' "${PREFIX}"
		printf "%15s '%s'\n" 'sysconfdir:' "${SYSCONFDIR}"
		printf "%15s '%s'\n" 'bindir:' "${BINDIR}"
		printf "%15s '%s'\n" 'sbindir:' "${SBINDIR}"
		printf "%15s '%s'\n" 'libdir:' "${LIBDIR}"
		printf "%15s '%s'\n" 'libexecdir:' "${LIBEXECDIR}"
		printf "%15s '%s'\n" 'docdir:' "${DOCDIR}"
		printf "%15s '%s'\n" 'mandir:' "${MANDIR}"
		exit 0
	fi

	# The remaining operand is the package source; default to the cwd.
	SOURCE="${1:-.}"
	test -d "${SOURCE}" || die "not a package directory: '${SOURCE}'"
	test -f "${SOURCE}/shpkg.vars" || die "no 'shpkg.vars' in '${SOURCE}'"

	import package

	# Read the data-only manifest (parsed, never sourced), then walk the
	# package's fixed layout.  Both run in this shell so the fields set by
	# pkg_manifest are visible to pkg_install_tree.
	pkg_manifest "${SOURCE}/shpkg.vars"
	pkg_install_tree "${SOURCE}"
}

# vim: filetype=sh
