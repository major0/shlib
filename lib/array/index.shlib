import array

__shlib_array_index()
{
	__shlib_array_index_shift="$((${2} - 1))"
	eval set -- "${1}"
	while test "${__shlib_array_index_shift}" -gt '0'; do
		shift
		__shlib_array_index_shift=$((__shlib_array_index_shift - 1))
	done
	unset __shlib_array_index_shift
	printf '%s\n' "${1}"
}
alias array.index='__shlib_array_index '

# vim: filetype=sh
