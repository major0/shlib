import string.escape
import array.append
import array.head
import array.index
import array.insert
import array.join
import array.length
import array.pop
import array.shift
import array.tail

__shlib_array()
{
	__shlib_array_out=''
	for __shlib_array_entry; do
		string.escape "${__shlib_array_entry}"
		__shlib_array_out="${__shlib_array_out}${SHLIB_RESULT} "
	done
	SHLIB_RESULT="${__shlib_array_out}"
	unset __shlib_array_out __shlib_array_entry
}
alias array='__shlib_array '

shlib.main {
	for arg; do
		case "${arg}" in (-h|-help|--help) shlib.doc 'array';; esac
	done

	__shlib_array "$@"
	printf '%s\n' "${SHLIB_RESULT}"
}

# vim: filetype=sh
