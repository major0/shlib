import array

__shlib_array_insert()
{
	__shlib_array_insert_data="${2}"
	eval set -- "${1}"
	set -- "${__shlib_array_insert_data}" "${@}"
	unset __shlib_array_insert_data
	__shlib_array "$@"
}
alias array.insert='__shlib_array_insert '

# vim: filetype=sh
