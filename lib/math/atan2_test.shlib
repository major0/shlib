import math.atan2

test_no_arguments() {
	test.error __shlib_math_atan2
}

test_too_few_arguments() {
	test.error __shlib_math_atan2 1
}

test_too_many_arguments() {
	test.error __shlib_math_atan2 1 2 3
}

test_exec() {
	test.ok __shlib_math_atan2 1 0
}

test_value() {
	__shlib_math_atan2 1 0
	test.eq '1.5707963' "$(shlib.printf '%0.7f' "${SHLIB_RESULT}")" 'atan2(1, 0)'
}

# vim: filetype=sh
