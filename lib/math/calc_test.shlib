import math.calc

test_no_arguments() {
	test.error __shlib_math_calc
}

test_bad_argument_list() {
	test.error __shlib_math_calc '1 2 3'
}

test_single_value() {
	test.ok __shlib_math_calc 1
}

test_expression() {
	test.ok __shlib_math_calc '1 + 1'
}

test_addition() {
	__shlib_math_calc '1 + 1'
	test.eq 2 "${SHLIB_RESULT}" 'addition'
}

test_subtraction() {
	__shlib_math_calc '2 - 1'
	test.eq 1 "${SHLIB_RESULT}" 'subtraction'
}

test_division() {
	__shlib_math_calc '20 / 2'
	test.eq 10 "${SHLIB_RESULT}" 'division'
}

test_multiplication() {
	__shlib_math_calc '3 * 5'
	test.eq 15 "${SHLIB_RESULT}" 'multiplication'
}

test_precedence() {
	__shlib_math_calc '1 + 2 * 3'
	test.eq 7 "${SHLIB_RESULT}" 'precedence'
}

test_parentheses() {
	__shlib_math_calc '(1 + 2) * 3'
	test.eq 9 "${SHLIB_RESULT}" 'parentheses'
}

test_reject_trailing_operator() {
	test.error __shlib_math_calc '1 +'
}

test_reject_divide_by_zero() {
	test.error __shlib_math_calc '1 / 0'
}

test_malformed_does_not_abort() {
	# In-process (not subshelled): a malformed expression must return, not
	# abort, so the final assertion is reached.
	__shlib_math_calc '1 +' || true
	__shlib_math_calc '5 / 0' || true
	test.ok true
}

test_float_still_supported() {
	# Floating-point expressions route to the float backend, not the
	# integer evaluator; they must keep working.
	test.ok __shlib_math_calc '0.5 + 0.5'
}

# vim: filetype=sh
