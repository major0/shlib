#
# math.seq is a stream generator, so its output is captured with $() (the
# idiomatic use) rather than read from SHLIB_RESULT.

import math.seq

test_no_arguments() {
	test.error __shlib_math_seq
}

test_too_many_arguments() {
	test.error __shlib_math_seq 1 2 3 4
}

test_range() {
	__out="$(__shlib_math_seq 1 3)"
	test.eq '1
2
3' "${__out}" 'seq 1 3'
	unset __out
}

test_single_argument_counts_from_one() {
	__out="$(__shlib_math_seq 3)"
	test.eq '1
2
3' "${__out}" 'seq 3 counts 1..3'
	unset __out
}

# vim: filetype=sh
