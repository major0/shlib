import math.int

test_no_arguments() {
	test.error __shlib_math_int
}

test_exec() {
	test.ok __shlib_math_int 1.0
}

test_float_to_int() {
	__shlib_math_int 2.0
	test.eq 2 "${SHLIB_RESULT}" 'float to int'
}

# vim: filetype=sh
