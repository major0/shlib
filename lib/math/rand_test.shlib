import math.rand

test_too_many_arguments() {
	test.error __shlib_math_rand 1
}

test_exec() {
	test.ok __shlib_math_rand
}

test_produces_a_value() {
	__shlib_math_rand
	test.ne '' "${SHLIB_RESULT}" 'rand produces a value'
}

# vim: filetype=sh
