import math.sum

test_no_arguments_is_zero() {
	__shlib_math_sum
	test.eq '0' "${SHLIB_RESULT}" 'empty sum is 0'
}

test_single_operand() {
	__shlib_math_sum 5
	test.eq '5' "${SHLIB_RESULT}" 'single operand'
}

test_sum_of_several() {
	__shlib_math_sum 1 2 3
	test.eq '6' "${SHLIB_RESULT}" 'sum of three operands'
}

test_sum_with_negative() {
	__shlib_math_sum 5 -5
	test.eq '0' "${SHLIB_RESULT}" 'sum including a negative'
}

# vim: filetype=sh
