import math.calc


__shlib_math_sum()
{
	while test "$#" -gt '0'; do
		case "${1}" in
		(--)	shift; break;;
		(*)	break;;
		esac
	done

	if test "$#" -lt '1'; then
		echo 0
		return
	fi

	# Join the operands with '+' into a single expression and evaluate it.
	__shlib_math_sum_ifs="${IFS}"
	IFS='+'
	set -- "$*"
	IFS="${__shlib_math_sum_ifs}"
	unset __shlib_math_sum_ifs

	__shlib_math_calc "${1}"
}
alias math.sum='__shlib_math_sum '

main {
	for arg; do
		case "${arg}" in (-h|-help|--help) shlib.doc 'math.sum';; esac
	done
	__shlib_math_sum "${@}"
}

# vim: filetype=sh
