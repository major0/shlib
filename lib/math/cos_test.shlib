import math.cos

test_no_arguments() {
	test.error __shlib_math_cos
}

test_too_many_arguments() {
	test.error __shlib_math_cos 1 2
}

test_exec() {
	test.ok __shlib_math_cos 1
}

test_value() {
	__shlib_math_cos 1
	test.eq '0.5403023059' "$(shlib.printf '%0.10f' "${SHLIB_RESULT}")" 'cos(1)'
}

# vim: filetype=sh
