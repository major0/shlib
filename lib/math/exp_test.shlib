import math.exp

test_no_arguments() {
	test.error __shlib_math_exp
}

test_too_many_arguments() {
	test.error __shlib_math_exp 1 2
}

test_exec() {
	test.ok __shlib_math_exp 1
}

test_value() {
	test.eq '2.71828' "$(__shlib_math_exp 1)" 'exp(1)'
}

# vim: filetype=sh
