import math.sqrt

test_no_arguments() {
	test.error __shlib_math_sqrt
}

test_too_many_arguments() {
	test.error __shlib_math_sqrt 1 2
}

test_exec() {
	test.ok __shlib_math_sqrt 2
}

test_perfect_square() {
	__shlib_math_sqrt 9
	test.eq '3' "${SHLIB_RESULT}" 'sqrt(9) = 3'
}

# vim: filetype=sh
