import math.log

test_no_arguments() {
	test.error __shlib_math_log
}

test_too_many_arguments() {
	test.error __shlib_math_log 1 2
}

test_exec() {
	test.ok __shlib_math_log 2
}

test_value() {
	__shlib_math_log 1
	test.eq '0' "${SHLIB_RESULT}" 'log(1) = 0'
}

# vim: filetype=sh
