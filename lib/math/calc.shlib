#
# math.calc evaluates an integer arithmetic expression.  It is a thin front end
# over the pure-shell evaluator (math.eval): all operands and operators are
# joined into one expression, which the evaluator parses and computes without
# forking and without ever hitting a fatal $(( )).  A malformed expression is
# rejected with a non-zero status.

import math.eval

__shlib_math_calc()
{
	: "__shlib_math_calc($*)"
	while test "$#" -gt '0'; do
		case "${1}" in
		(--)	shift; break;;
		(*)	break;;
		esac
	done

	if test "$#" -eq '0'; then
		shlib.usage 'math.calc' 'too few arguments'
		return 1
	fi

	__shlib_math_eval "$*" || return 1
	echo "${SHLIB_RESULT}"
}
alias math.calc='__shlib_math_calc '

main {
	for arg; do
		case "${arg}" in (-h|-help|--help) shlib.doc 'math.calc';; esac
	done
	__shlib_math_calc "${@}"
}

# vim: filetype=sh
