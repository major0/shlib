#
# math.calc evaluates an arithmetic expression.  An integer expression is
# handled by the pure-shell evaluator (math.eval): fork-free, and a malformed
# expression is rejected with a non-zero status instead of the fatal $(( ))
# that would otherwise abort the caller.  An expression containing a floating
# point operand ('.') falls back to a float backend, since the evaluator is
# integer-only.

import math.eval

# Float backend, selected once per shell.  awk is preferred: it is widely
# present and, being a separate process, a malformed float expression fails
# cleanly rather than aborting.  Native $(( )) float support (zsh, ksh93) is
# used only when awk is absent.
if shlib.hascmd awk; then
	__shlib_math_calc_float() { command awk "BEGIN{ print $* }"; }
elif test "${SHLIB_SHELL_IMPL}" = 'zsh' || test "${SHLIB_SHELL_IMPL}" = 'ksh93'; then
	__shlib_math_calc_float() { set -- "$(($*))"; echo "${1%.}"; }
elif shlib.hascmd ksh; then
	__shlib_math_calc_float() { command ksh -c "echo \$(($*))"; }
elif shlib.hascmd zsh; then
	__shlib_math_calc_float() { command zsh -c "__r=\$(($*)); echo \"\${__r%.}\""; }
else
	__shlib_math_calc_float() { shlib.error 'math.calc: no floating-point backend'; return 1; }
fi

__shlib_math_calc()
{
	: "__shlib_math_calc($*)"
	while test "$#" -gt '0'; do
		case "${1}" in
		(--)	shift; break;;
		(*)	break;;
		esac
	done

	if test "$#" -eq '0'; then
		shlib.usage 'math.calc' 'too few arguments'
		return 1
	fi

	case "$*" in
	(*.*)	SHLIB_RESULT="$(__shlib_math_calc_float "$*")" || return 1;;
	(*)	__shlib_math_eval "$*" || return 1;;
	esac
}
alias math.calc='__shlib_math_calc '

main {
	for arg; do
		case "${arg}" in (-h|-help|--help) shlib.doc 'math.calc';; esac
	done
	__shlib_math_calc "${@}"
	printf '%s\n' "${SHLIB_RESULT}"
}

# vim: filetype=sh
