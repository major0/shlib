import string.escape

__shlibdir() { printf '%s' "${__pkg_prefix}/lib/shlib"; }
shlibinto() {
	: "shlibinto: $*"
	# string.escape publishes a single-quoted word in SHLIB_RESULT, so it
	# can be embedded directly to bake the (possibly odd) path into the
	# accessor safely.
	string.escape "${1}"
	eval "__shlibdir(){ printf '%s' ${SHLIB_RESULT}; }"
}

doshlib() {
	: "doshlib: $*"
	while test "$#" -gt '0'; do
		find "${1}" -type f -name '*.shlib' | docpio -X '*-test.shlib' "$(__shlibdir)"
		shift
	done
}

# vim: filetype=sh
