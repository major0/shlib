#
# doshlib installs a directory of *.shlib libraries (excluding *_test.shlib)
# under the installer's resolved LIBDIR/shlib by default; shlibinto overrides.

shlibinto() { __pkg_shlibdir="${1}"; }

doshlib() {
	: "doshlib: $*"
	__doshlib_dir="${__pkg_shlibdir:-${LIBDIR}/shlib}"
	while test "$#" -gt '0'; do
		find "${1}" -type f -name '*.shlib' | docpio -X '*_test.shlib' "${__doshlib_dir}"
		shift
	done
	unset __doshlib_dir
}

# vim: filetype=sh
