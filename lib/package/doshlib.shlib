__shlibdir() { printf '%s' "${__pkg_prefix}/lib/shlib"; }
shlibinto() {
	: "shlibinto: $*"
	eval "__shlibdir(){ printf '%s' '$(__string_escape "${1}")'; }"
}

doshlib() {
	: "doshlib: $*"
	while test "$#" -gt '0'; do
		find "${1}" -type f -name '*.shlib' | docpio -X '*-test.shlib' "$(__shlibdir)"
		shift
	done
}

# vim: filetype=sh
