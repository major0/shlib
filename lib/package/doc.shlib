#
# dodoc installs documentation under DOCDIR/<package name>; docinto sets an
# optional subdirectory beneath it (e.g. docinto examples).

docinto() { __pkg_docsubdir="${1}"; }

dodoc() {
	: "dodoc: $*"
	__dodoc_dest="${DOCDIR}${NAME:+/${NAME}}${__pkg_docsubdir:+/${__pkg_docsubdir}}"
	dodir "${__dodoc_dest}"
	docmd install -m0644 -t "${__dodoc_dest}" "${@}"
	unset __dodoc_dest
}

# vim: filetype=sh
