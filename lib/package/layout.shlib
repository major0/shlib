#
# Static FHS layout walker.
#
# `shlib install` handles only shlib packages: every executable is a
# `#!/usr/bin/env shlib` script and every library is a *.shlib file.  Because
# of that the install layout is fixed and the package gets no say in it -- the
# rules below are applied, in order, against the package source tree.  The do*
# verbs are the walker's internal engine; a package can never call them,
# because its manifest is parsed as data and is never sourced.
#
# Only the top-level launcher is templated.  It is the one file that must know
# its own install paths (it bootstraps SHLIB_PATH and the libexec dir before
# the shlib runtime exists); every other shlib script obtains its paths from
# the runtime at execution time, so it is installed verbatim.
#
#   <name>       (top-level launcher) -> BINDIR            (templated, 0755)
#   bin/*                             -> BINDIR            (0755)
#   sbin/*                            -> SBINDIR           (0755)
#   libexec/*                         -> LIBEXECDIR/<name> (0755)
#   lib/*/ (skip deprecated)          -> LIBDIR/shlib      (0644, no *_test)
#   README* LICENSE* doc/*            -> DOCDIR/<name>     (0644)

pkg_install_tree() {
	: "pkg_install_tree: $*"
	test -n "${NAME}" || die 'pkg_install_tree: NAME unset (parse the manifest first)'

	__pkg_src="${1:-.}"
	test -d "${__pkg_src}" || die "pkg_install_tree: not a directory: ${__pkg_src}"

	(cd "${__pkg_src}" || die "pkg_install_tree: cannot enter ${__pkg_src}"

	# 1. Top-level launcher named after the package -> BINDIR, templated.
	if test -f "${NAME}"; then
		dobin --template "${NAME}"
	fi

	# 2/3. bin/ and sbin/ scripts -> BINDIR/SBINDIR, verbatim.
	if test -d bin; then
		for __pkg_f in bin/*; do
			test -f "${__pkg_f}" && dobin "${__pkg_f}"
		done
	fi
	if test -d sbin; then
		for __pkg_f in sbin/*; do
			test -f "${__pkg_f}" && dosbin "${__pkg_f}"
		done
	fi

	# 4. libexec/ helpers -> LIBEXECDIR/<name>, verbatim.
	if test -d libexec; then
		exeinto "${LIBEXECDIR}/${NAME}"
		for __pkg_f in libexec/*; do
			test -f "${__pkg_f}" && doexe "${__pkg_f}"
		done
	fi

	# 5. lib/ subtrees -> LIBDIR/shlib.  Enter lib/ so the installed paths
	#    are relative to it (lib/array -> LIBDIR/shlib/array); skip the
	#    deprecated subtree; doshlib itself drops *_test.shlib files.
	if test -d lib; then
		(cd lib && for __pkg_d in */; do
			__pkg_d="${__pkg_d%/}"
			test -d "${__pkg_d}" || continue
			test "${__pkg_d}" != 'deprecated' || continue
			doshlib "${__pkg_d}"
		done)
	fi

	# 6. Documentation -> DOCDIR/<name>.
	for __pkg_f in README* LICENSE*; do
		test -f "${__pkg_f}" && dodoc "${__pkg_f}"
	done
	if test -d doc; then
		for __pkg_f in doc/*; do
			test -f "${__pkg_f}" && dodoc "${__pkg_f}"
		done
	fi
	)

	unset __pkg_src
}

# vim: filetype=sh
