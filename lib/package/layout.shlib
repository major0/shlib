#
# Static FHS layout walker.
#
# `shlib install` handles only shlib packages: every executable is a
# `#!/usr/bin/env shlib` script and every library is a *.shlib file.  A package
# is a directory holding a shpkg.vars manifest and a strict subset of the
# standard unix layout; only these directories are installed, and the package
# gets no say in where they land.  The do* verbs are the walker's internal
# engine; a package can never call them (its manifest is data, never sourced).
#
#   bin/*      -> BINDIR            (templated, 0755)
#   lib/*      -> LIBDIR/shlib      (0644, excludes *_test.shlib)
#   libexec/*  -> LIBEXECDIR/<name> (0755)
#   docs/*     -> DOCDIR/<name>     (0644)
#
# Only bin/ is templated: a launcher must know its own install paths before the
# shlib runtime exists (it is the sole place the @shlib_*@ tokens appear); a
# script with no tokens is copied unchanged.  Any subdirectory that is not one
# of these four is ignored -- a nested package (its own shpkg.vars) is a module
# in its own right and is installed only when addressed directly, never pulled
# in by its parent (as in Go).

pkg_install_tree() {
	: "pkg_install_tree: $*"
	test -n "${NAME}" || die 'pkg_install_tree: NAME unset (parse the manifest first)'

	__pkg_src="${1:-.}"
	test -d "${__pkg_src}" || die "pkg_install_tree: not a directory: ${__pkg_src}"

	(cd "${__pkg_src}" || die "pkg_install_tree: cannot enter ${__pkg_src}"

	# bin/ -> BINDIR, templated.  Enter bin/ so each verb sees a bare
	# filename (dobin --template names the destination after its argument).
	if test -d bin; then
		(cd bin && for __pkg_f in *; do
			test -f "${__pkg_f}" || continue
			dobin --template "${__pkg_f}"
		done)
	fi

	# lib/ -> LIBDIR/shlib.  Enter lib/ so installed paths are relative to
	# it (lib/array -> LIBDIR/shlib/array).  Each entry is handed to doshlib,
	# which finds the *.shlib files beneath it and drops *_test.shlib; an
	# entry with no libraries (e.g. deprecated/) simply installs nothing.
	if test -d lib; then
		(cd lib && for __pkg_e in *; do
			test -e "${__pkg_e}" || continue
			doshlib "${__pkg_e}"
		done)
	fi

	# libexec/ -> LIBEXECDIR/<name>.
	if test -d libexec; then
		exeinto "${LIBEXECDIR}/${NAME}"
		for __pkg_f in libexec/*; do
			test -f "${__pkg_f}" && doexe "${__pkg_f}"
		done
	fi

	# docs/ -> DOCDIR/<name>.
	if test -d docs; then
		for __pkg_f in docs/*; do
			test -f "${__pkg_f}" && dodoc "${__pkg_f}"
		done
	fi
	)

	unset __pkg_src
}

# vim: filetype=sh
