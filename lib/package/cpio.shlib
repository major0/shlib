import array

# A minimalistic `cpio`-style copy suitable for use in shlib.
#
#	<paths on stdin> | docpio [-X <glob>]... <destdir>
#
# Each path read from stdin is installed under <destdir>, preserving its
# relative path.  Directories read on stdin are ignored (only the directories
# leading to files are created); a path matching any -X <glob> is skipped.
docpio()
{(
	: "docpio: $*"

	array
	__docpio_exclude="${SHLIB_RESULT}"
	while test "$#" -gt '0'; do
		case "${1}" in
		(-X|--exclude)
			test "$#" -gt '1' || die "missing argument for ${1}"
			case "${2}" in (-*) die "missing argument for ${1}";; esac
			array.append "${__docpio_exclude}" "${2}"
			__docpio_exclude="${SHLIB_RESULT}"
			shift;;
		(--) shift; break;;
		(-*) die "invalid option: ${1}";;
		(*) break;;
		esac
		shift
	done

	__docpio_destdir="${1%/}"

	while read -r __docpio_file; do
		# Only files are installed; skip directories read from stdin.
		! test -d "${__docpio_file}" || continue

		# Skip paths matching any -X exclude glob.  Use a distinct loop
		# variable so the exclude list survives into the next iteration.
		eval set -- "${__docpio_exclude}"
		__docpio_excluded='false'
		for __docpio_pattern; do
			# shellcheck disable=SC2254
			case "${__docpio_file}" in
			(${__docpio_pattern}) __docpio_excluded='true'; break;;
			esac
		done
		if "${__docpio_excluded}"; then continue; fi

		# Create the leading directory (or destdir itself for a bare
		# filename) and install the file preserving its relative path.
		__docpio_dir="${__docpio_file%/*}"
		test "${__docpio_dir}" != "${__docpio_file}" || __docpio_dir='.'
		dodir "${__docpio_destdir}/${__docpio_dir}"
		docmd install -m0644 "${__docpio_file}" "${__docpio_destdir}/${__docpio_file}"
	done
	unset __docpio_file __docpio_exclude __docpio_destdir __docpio_dir \
		__docpio_excluded __docpio_pattern
)}

# vim: filetype=sh
