#
# dobin/dosbin install to the installer's resolved BINDIR/SBINDIR by default.
# bininto/sbininto override the target for a single package.

bininto() { __pkg_bindir="${1}"; }

dobin() {
	: "dobin: $*"
	__dobin_dir="${__pkg_bindir:-${BINDIR}}"
	dodir "${__dobin_dir}"

	if test "${1}" = '--template'; then
		shift
		while test "$#" -gt '0'; do
			dotemplate "${1}" "${__dobin_dir}/${1}"
			fperms 0755 "${__dobin_dir}/${1}"
			shift
		done
	else
		docmd install -m0755 -t "${__dobin_dir}" "${@}"
	fi
	unset __dobin_dir
}

sbininto() { __pkg_sbindir="${1}"; }

dosbin() {
	: "dosbin: $*"
	__dosbin_dir="${__pkg_sbindir:-${SBINDIR}}"
	dodir "${__dosbin_dir}"

	if test "${1}" = '--template'; then
		shift
		while test "$#" -gt '0'; do
			dotemplate "${1}" "${__dosbin_dir}/${1}"
			fperms 0755 "${__dosbin_dir}/${1}"
			shift
		done
	else
		docmd install -m0755 -t "${__dosbin_dir}" "${@}"
	fi
	unset __dosbin_dir
}

# vim: filetype=sh
