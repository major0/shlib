#
# doexe installs executables to the installer's resolved LIBEXECDIR by default;
# exeinto overrides the target and exeopts overrides the install options.

exeopts() { __pkg_exeopts="${*}"; }
exeinto() { __pkg_exedir="${1}"; }

doexe() {
	: "doexe: $*"
	__doexe_dir="${__pkg_exedir:-${LIBEXECDIR}}"
	dodir "${__doexe_dir}"
	# Options intentionally word-split so exeopts can carry multiple flags.
	# shellcheck disable=SC2086
	docmd install ${__pkg_exeopts:--m0755} -t "${__doexe_dir}" "${@}"
	unset __doexe_dir
}

# vim: filetype=sh
