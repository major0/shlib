exeopts() {
	: "exeopts: $*"
	eval "__pkg_exeopts(){ printf '%s' '${1}'; }"
}
exeopts '-m0755'

__pkg_exeinto() { die "exeinto not called"; }
exeinto() {
	: "exeinto: $*"
	eval "__pkg_exeinto(){ printf '%s' '${1}'; }"
}

doexe() {
	: "doexe: $*"
	dodir "$(__pkg_exeinto)"
	docmd install "$(__pkg_exeopts)" -t "$(__pkg_exeinto)" "${@}"
}

# vim: filetype=sh
