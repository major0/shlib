#
# doins installs miscellaneous files.  Unlike dobin/dodoc there is no sensible
# default location, so insinto must set the target first (as in ebuild).

insinto() { __pkg_insdir="${1}"; }
insopts() { __pkg_insopts="${*}"; }
insopts '-m0644'

doins() {
	: "doins: $*"
	test -n "${__pkg_insdir}" || die 'doins: insinto must be called first'
	dodir "${__pkg_insdir}"
	# Options intentionally word-split so insopts can carry multiple flags.
	# shellcheck disable=SC2086
	docmd install ${__pkg_insopts:--m0644} -t "${__pkg_insdir}" "${@}"
}

# vim: filetype=sh
