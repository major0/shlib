docmd() {
	: "docmd: $*"
	# DRYRUN is the installer's 'true'/'false' flag, executed as a command
	# in the same style as the installer's other boolean switches.  When
	# unset (helpers used outside the installer) commands run for real.
	if "${DRYRUN:-false}"; then
		echo "do: $*" >&2
	else
		"${@}"
	fi
}

# vim: filetype=sh
