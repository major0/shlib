import string.toupper

test_too_few_arguments() {
	test.error __shlib_string_toupper
}

test_uppercases() {
	__shlib_string_toupper 'Hello World'
	test.eq 'HELLO WORLD' "${SHLIB_RESULT}" 'mixed case to upper'
}

test_already_upper() {
	__shlib_string_toupper 'ABC'
	test.eq 'ABC' "${SHLIB_RESULT}" 'already uppercase'
}

test_brackets_preserved() {
	__shlib_string_toupper '[abc]'
	test.eq '[ABC]' "${SHLIB_RESULT}" 'brackets preserved'
}

# vim: filetype=sh
