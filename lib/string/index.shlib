__shlib_string_index_cmd()
{
	set -- "${2%%"${1}"*}" "${@}"
	if test "${1}" = "${3}"; then
		SHLIB_RESULT=0
	else
		SHLIB_RESULT=$((${#1} + 1))
	fi
}

__shlib_string_index()
{
	while test "$#" -gt '0'; do
		case "${1}" in
		(--)	shift; break;;
		(-*)	shlib.usage 'string.index' "unknown option '${1}'"
			return 1;;
		(*)	break;;
		esac
	done

	if test "$#" -lt '2'; then
		shlib.usage 'string.index' 'too few arguments'
		return 1
	fi

	if test "$#" -gt '2'; then
		shlib.usage 'string.index' 'too many arguments'
		return 1
	fi

	__shlib_string_index_cmd "$@"
}
alias string.index='__shlib_string_index '

shlib.main {
	for arg; do
		case "${arg}" in (-h|-help|--help) shlib.doc 'string.index';; esac
	done
	__shlib_string_index "$@"
	printf '%s\n' "${SHLIB_RESULT}"
}

# vim: filetype=sh
