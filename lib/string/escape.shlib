## string.escape <string>
# Quote <string> into a single shell word that evaluates back to the original.
# It uses single-quote quoting -- every `'` becomes `'\''` and the whole string
# is wrapped in `'...'` -- which is pure parameter expansion: no subshell and no
# external tool, and it safely handles every byte, including spaces, newlines,
# glob characters, and quotes.  The quoted word is published in `SHLIB_RESULT`.
__shlib_string_escape()
{
	__shlib_string_escape_q="'"
	__shlib_string_escape_out=''
	__shlib_string_escape_in="${1}"
	while case "${__shlib_string_escape_in}" in
		(*${__shlib_string_escape_q}*)	: ;;
		(*)				false ;;
		esac
	do
		__shlib_string_escape_out="${__shlib_string_escape_out}${__shlib_string_escape_in%%"${__shlib_string_escape_q}"*}${__shlib_string_escape_q}\\${__shlib_string_escape_q}${__shlib_string_escape_q}"
		__shlib_string_escape_in="${__shlib_string_escape_in#*"${__shlib_string_escape_q}"}"
	done
	SHLIB_RESULT="${__shlib_string_escape_q}${__shlib_string_escape_out}${__shlib_string_escape_in}${__shlib_string_escape_q}"
	unset __shlib_string_escape_q __shlib_string_escape_out __shlib_string_escape_in
}
alias string.escape='__shlib_string_escape '

shlib.main {
	for arg; do
		case "${arg}" in (-h|-help|--help) shlib.doc 'string.escape';; esac
	done
	__shlib_string_escape "${*}"
	printf '%s\n' "${SHLIB_RESULT}"
}

# vim: filetype=sh
