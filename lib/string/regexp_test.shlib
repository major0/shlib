#
# string.regexp is a status predicate (success == a subject matched the
# pattern), so it is asserted with test.ok / test.error.

import string.regexp

test_too_few_arguments() {
	test.error __shlib_string_regexp a
}

test_match() {
	test.ok __shlib_string_regexp 'ell' hello
}

test_no_match() {
	test.error __shlib_string_regexp 'xyz' hello
}

test_match_among_several_subjects() {
	test.ok __shlib_string_regexp 'lo' foo bar hello
}

# vim: filetype=sh
