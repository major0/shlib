import string.index

test_too_few_arguments() {
	test.error __shlib_string_index a
}

test_first_char() {
	__shlib_string_index h hello
	test.eq 1 "${SHLIB_RESULT}" 'index of h in hello'
}

test_found() {
	__shlib_string_index l hello
	test.eq 3 "${SHLIB_RESULT}" 'index of l in hello'
}

test_not_found() {
	__shlib_string_index x hello
	test.eq 0 "${SHLIB_RESULT}" 'not found is 0'
}

# vim: filetype=sh
