#
# string.compare is a status predicate (success == equal), so it is asserted
# with test.ok / test.error rather than a SHLIB_RESULT value.

import string.compare

test_too_few_arguments() {
	test.error __shlib_string_compare a
}

test_equal() {
	test.ok __shlib_string_compare abc abc
}

test_unequal() {
	test.error __shlib_string_compare abc abd
}

test_case_sensitive_by_default() {
	test.error __shlib_string_compare ABC abc
}

test_ignore_case_equal() {
	test.ok __shlib_string_compare -i ABC abc
}

test_ignore_case_unequal() {
	test.error __shlib_string_compare -i ABC abd
}

# vim: filetype=sh
